# Modelo de variáveis de ambiente (.env)
# Copie para .env e preencha os valores. Nunca commite .env com dados reais.

SECRET_KEY=
DEBUG=False
DATABASE_URL=
# PgBouncer (Railway nativo): runtime pooled; migrations/advisory locks via unpooled
# DATABASE_UNPOOLED_URL=
# PGBOUNCER_ENABLED=true
# DB_CONN_MAX_AGE=60

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# UOL Host (bo@recordpap.com.br)
EMAIL_HOST=smtps.uhserver.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=bo@recordpap.com.br
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Record PAP <bo@recordpap.com.br>

# Cloudflare R2 (armazenamento de arquivos)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=site-record-midia
CLOUDFLARE_R2_PUBLIC_URL=
R2_FOLDER_ROOT=CDOI_Record_Vertical

# IA no bot WhatsApp: Groq (recomendado, cota free maior) e/ou Gemini (fallback)
GROQ_API_KEY=
GEMINI_API_KEY=
# Opcional: limites de caracteres do contexto. Valores altos causam 413 no Groq (IA perde documentos/URLs).
# Defaults: DOCS=8000, URLS=8000, CONHECIMENTO=18000, SCHEMA=3000
# IA_MAX_CHARS_DOCS=8000
# IA_MAX_CHARS_URLS=8000
# IA_MAX_CHARS_CONHECIMENTO=18000
# IA_MAX_CHARS_SCHEMA=3000

ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# WhatsApp — provedor ativo fica no banco (tela Config WhatsApp).
# Modos: zapi | evolution | whatsatende | hybrid
# hybrid = Z-API (equipe/grupos) + WhatsAtende Número B (cliente / Cloud API)
# WHATSAPP_PROVIDER=hybrid
WHATSATENDE_API_URL=https://api.app14.whatsatende.com.br
# Número A WhatsAtende — opcional no hybrid (pode desligar no painel WA)
WHATSATENDE_TOKEN=
WHATSATENDE_WHATSAPP_ID=
# Número B — cliente final (Cloud API oficial) — obrigatório no hybrid
WHATSATENDE_TOKEN_B=
WHATSATENDE_WHATSAPP_ID_B=
# Segredo no path do webhook inbound (WhatsAtende):
# https://www.recordpap.com.br/api/crm/webhook-whatsapp/<WHATSATENDE_WEBHOOK_TOKEN>/
WHATSATENDE_WEBHOOK_TOKEN=
# Templates Meta Nio (vazio = automático se whatsatende/hybrid; produção: True)
# WHATSAPP_USE_NIO_TEMPLATES=True

# URL pública do site (links de mídia em notificações Teams)
SITE_URL=https://www.recordpap.com.br
# Teams: Django → n8n → Incoming Webhook do canal Teams
N8N_TEAMS_WEBHOOK_URL=

# Scheduler: rodar em processo/serviço separado (não no Gunicorn)
# Local: python manage.py run_scheduler
# Railway: segundo serviço, start command acima, replicas=1

# Performance (produção Railway)
# FOLHA_COMISSAO_CACHE_ENABLED=True
# FOLHA_COMISSAO_CACHE_TTL=1800
# WHATSAPP_WEBHOOK_ASYNC=True
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=2
# FOLHA_COMISSAO_RATE_LIMIT=6
# FOLHA_COMISSAO_RATE_PERIOD=60
# FOLHA_COMISSAO_TIMEOUT_SECONDS=90
# DB_CONN_MAX_AGE=120
# STATIC_CACHE_MAX_AGE=86400

# DFV Power BI ao vivo (comando WhatsApp DFV; FACHADA continua na base local)
# DFV_POWERBI_ENABLED=True
# DFV_POWERBI_RESOURCE_KEY=8a9db8f9-7cf1-4db5-90d2-5259ad149eba
# DFV_POWERBI_TENANT=85b28421-d45a-4b07-889d-24b528c7f250
# DFV_POWERBI_CLUSTER=https://wabi-brazil-south-b-primary-api.analysis.windows.net
# DFV_POWERBI_MODEL_ID=6061538
# DFV_POWERBI_SP_RESOURCE_KEY=81e95c1a-e770-44e3-9646-19df8443756c
# DFV_POWERBI_SP_MODEL_ID=7340452
# DFV_POWERBI_SUL_RESOURCE_KEY=cc212c25-1b6a-4301-877b-703e2c7aa788
# DFV_POWERBI_SUL_MODEL_ID=6062850
# DFV_POWERBI_TIMEOUT_SECONDS=18
# DFV_POWERBI_CACHE_TTL_SECONDS=600

# Sentry (tier gratuito — https://sentry.io)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Serviço PAP dedicado (3º serviço Railway — railway.pap.toml)
# No serviço WEB: PAP_USE_DEDICATED_WORKER=True
# No serviço PAP:  PAP_WORKER_MODE=True
# PAP_WORKER_POLL_SECONDS=2
# Sessões Playwright (cookies/JWT) — local: omita; Railway PAP: /data/pap_sessions
# PAP_SESSIONS_DIR=/data/pap_sessions

# Serviço webhook WhatsApp dedicado (4º serviço Railway — railway.webhook.toml)
# No serviço WEB: WHATSAPP_USE_DEDICATED_WORKER=True, WHATSAPP_WEBHOOK_ASYNC=True
# No serviço WEBHOOK: WHATSAPP_WORKER_MODE=True, WHATSAPP_WEBHOOK_ASYNC=False
# WHATSAPP_WORKER_POLL_SECONDS=1

CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=capsolver

# Opcional/local
NIO_STORAGE_STATE=

# PAP / VENDER no WhatsApp (homologação)
# PAP_WHATSAPP_PERMITIR_FORCAR_SIM_CLIENTE=true
# Com DEBUG=True: após o resumo, confirma o SIM do cliente sozinho (só .env local)
# PAP_WHATSAPP_AUTO_SIM_CLIENTE_LOCAL=true
# PAP_ETAPA7_AGENDAMENTO_TIMEOUT_MS=120000

# Assertiva Localize — dados reais no fluxo CRÉDITO (finalidade LGPD: ciclo de crédito)
ASSERTIVA_CLIENT_ID=
ASSERTIVA_CLIENT_SECRET=
# ASSERTIVA_CREDITO_ENABLED=true
# Dado ausente na Assertiva não interrompe a análise: a automação completa o
# campo (celular sorteado, e-mail validado do pool, endereço padrão).
# ASSERTIVA_TIMEOUT_SECONDS=20
